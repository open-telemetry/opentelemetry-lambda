{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'helpers:pinGitHubActionDigestsToSemver',
    ':separateMultipleMajorReleases',
  ],
  gitIgnoredAuthors: [
    "107717825+opentelemetrybot@users.noreply.github.com",
    "107717825+opentelemetrybot[bot]@users.noreply.github.com",
    "197425009+otelbot@users.noreply.github.com",
    "197425009+otelbot[bot]@users.noreply.github.com",
    "github-actions[bot]@users.noreply.github.com"
  ],
  prHourlyLimit: 15,
  prConcurrentLimit: 15,
  ignorePaths: [
    // re‑declare everything best-practices ignores
    "**/vendor/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/.cache/**",
  ],
  packageRules: [
    {
      labels: [
        'dependencies',
        'go',
      ],
      matchCategories: [
        'golang',
      ],
    },
    {
      labels: [
        'dependencies',
        'dotnet'
      ],
      matchCategories: [
        'dotnet'
      ],
    },
    {
      labels: [
        'dependencies',
        'java',
      ],
      matchCategories: [
        'java',
      ],
    },
    {
      labels: [
        'dependencies',
        'javascript',
      ],
      matchCategories: [
        'js',
      ],
    },
    {
      labels: [
        'dependencies',
        'python',
      ],
      matchCategories: [
        'python',
      ],
    },
    {
      labels: [
        'dependencies',
        'ruby',
      ],
      matchCategories: [
        'ruby',
      ],
    },
    {
      labels: [
        'dependencies',
        'github_actions',
      ],
      matchManagers: [
        'github-actions',
      ],
    },
    {
      groupName: 'collector-other',
      matchUpdateTypes: [
        '!major'
      ],
      matchCategories: [
        'golang',
      ],
      postUpdateOptions: [
		'gomodTidy',
	  ],
      semanticCommitType: 'build',
      schedule: [
        'before 8am on Monday',
      ],
    },
    {
      groupName: 'opentelemetry-deps-collector',
      matchUpdateTypes: [
        '!major'
      ],
      matchPackageNames: [
        'go.opentelemetry.io{/,}**',
        'github.com/open-telemetry{/,}**'
      ],
      matchCategories: [
        'golang',
      ],
      postUpdateOptions: [
		'gomodTidy',
	  ],
      semanticCommitType: 'build',
      schedule: [
        'before 8am on Monday',
      ],
    },
    {
      groupName: '{{categories}}-other',
      matchUpdateTypes: [
        '!major',
        '!lockFileMaintenance',
      ],
      semanticCommitType: 'build',
      schedule: [
        'before 8am on Monday'
      ],
    },
    {
      groupName: 'opentelemetry-deps-{{categories}}',
      matchUpdateTypes: [
        '!major',
        '!lockFileMaintenance',
      ],
      matchDepNames: [
        '@opentelemetry/**',
        'io.opentelemetry.**',
        'OpenTelemetry.**',
        'opentelemetry-**',
      ],
      schedule: [
        'before 8am on Monday'
      ],
      semanticCommitType: 'build',
    },
    {
      matchPackageNames: [
        'io.opentelemetry.instrumentation:opentelemetry-instrumentation-bom-alpha',
        'io.opentelemetry.contrib:opentelemetry-aws-resources',
        'opentelemetry-*',
      ],
      // Renovate's default behavior is only to update from unstable -> unstable if it's for the
      // major.minor.patch, under the assumption that you would want to update to the stable version
      // of that release instead of the unstable version for a future release (but there's never any
      // stable version of opentelemetry-instrumentation-bom-alpha so this logic doesn't apply
      ignoreUnstable: false,
      allowedVersions: '!/\\-SNAPSHOT$/'
    },
    {
      groupName: 'actions',
      matchUpdateTypes: [
        '!major'
      ],
      matchManagers: [
        'github-actions',
      ],
      schedule: [
        'before 8am on Monday',
      ],
    },
    {
      matchUpdateTypes: [
        'major'
      ],
      matchManagers: [
        'github-actions',
      ],
      semanticCommitType: 'build',
      schedule: [
        'before 8am on Monday',
      ],
    },
    {
      groupName: '{{categories}}',
      matchCategories: [
        'docker',
        'terraform',
      ],
      matchUpdateTypes: [
        '!lockFileMaintenance',
      ],
      semanticCommitType: 'build',
      schedule: [
        'before 8am on Monday',
      ],
    },
    {
      matchUpdateTypes: [
        'major'
      ],
      matchManagers: [
        '!github-actions',
      ],
      "dependencyDashboardApproval": true,
    },
  ],
  lockFileMaintenance: {
    enabled: true,
    branchTopic: 'lock-file-maintenance-{{categories}}',
    schedule: [
      'before 8am on Wednesday',
    ],
  },
  postUpdateOptions: [
	'gomodTidy',
  ],
  semanticCommits: 'enabled',
  semanticCommitType: 'build',
  semanticCommitScope: 'deps',
  labels: [
    'dependencies',
  ],
}
